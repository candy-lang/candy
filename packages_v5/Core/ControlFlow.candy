use Core
use Core.Int
use Core.Operators.Compare
use Core.Panic
use Core.Primitives

public fun loop(body: () Nothing) {
  body()
  loop(body)
}

public fun repeat(times: Int, body: () Nothing) {
  needs(times.isNonNegative())
  switch times.isGreaterThan(0) {
    false => {},
    true => {
      body()
      repeat(times.subtract(1), body)
    },
  }
}
