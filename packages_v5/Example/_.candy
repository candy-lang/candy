fun run(widget: Widget, windowSize: Size) {
  let state = widget.initialState()
  let laidOutChild = widget.layout(state, Constraints.tight(windowSize), Context())
  print("Laid out child: {laidOutChild.toText()}")
  let positionedChild = laidOutChild.place(Offset(0, 0))
  print("Positioned child: {positionedChild.toText()}")
  let drawCommands = positionedChild.paint()
  print("Draw commands: {drawCommands.toText()}")

  builtinCairoRender(drawCommands)
}
