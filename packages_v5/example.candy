# calculator
# 2048
# sudoku

struct LinkedList {
  data: Int,
  next: Maybe[LinkedList],
}
impl LinkedList: ToText {
  fun toText(self: LinkedList) Text {
    let foo = switch self.next {
      none => "()",
      some(next) => next.toText(),
    }
    "({self.data.toText()}, {foo})"
  }
}
