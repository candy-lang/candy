use Core.Any
use Oxygen.Color
use Oxygen.Constraints
use Oxygen.DrawCommand
use Oxygen.Offset
use Oxygen.Rect
use Oxygen.Size

public trait Widget {
  fun initialState(self: Self) Any
  fun layout(self: Self, state: Any, constraints: Constraints, context: Context) LaidOutWidget[Any]
  fun paint(self: Self, state: Any, size: Size) List[DrawCommand]
  fun handle(self: Self, state: Any, path: List[Int], message: Any) Any
}

public struct Child {
  public widget: Widget,
  public state: Any,
}
impl Child {
  public fun layout(self: Self, constraints: Constraints, context: Context) LaidOutWidget[Any] {
    let result = self.widget.layout(self.state, constraints, context)
    LaidOutWidget(self.widget, result.state, result.size)
  }
}
impl Child {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget, state if possible
    "Child(widget: <opaque>, state: <opaque>)"
  }
}

public struct LaidOutWidget[S] {
  public widget: Widget,
  public state: S,
  public size: Size,
}
impl [S] LaidOutWidget[S] {
  public fun place(self: Self, offset: Offset) PositionedWidget[S] {
    PositionedWidget(self.widget, self.state, Rect.fromOffsetAndSize(offset, self.size))
  }
}
impl [S: ToText] LaidOutWidget[S] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget if possible
    "LaidOutWidget(widget: <opaque>, state: {self.state.toText()}, size: {self.size.toText()})"
  }
}
impl LaidOutWidget[Any] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget, state if possible
    "LaidOutWidget(widget: <opaque>, state: <opaque>, size: {self.size.toText()})"
  }
}

public struct LaidOutChild[S] {
  public state: S,
  public size: Size,
}
impl [S: ToText] LaidOutChild[S] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget if possible
    "LaidOutChild(state: {self.state.toText()}, size: {self.size.toText()})"
  }
}
impl LaidOutChild[Any] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget, state if possible
    "LaidOutChild(state: <opaque>, size: {self.size.toText()})"
  }
}

public struct PositionedWidget[S] {
  public widget: Widget,
  public state: S,
  public rect: Rect,
}
impl [S] PositionedWidget[S] {
  public fun paint(self: Self) List[DrawCommand] {
    List.of(DrawCommand.save(), DrawCommand.translate(self.rect.topLeft()))
      .concat(self.widget.paint(self.state, self.rect.size()))
      .concat(List.of(DrawCommand.restore()))
  }
}
impl [S: ToText] PositionedWidget[S] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget if possible
    "PositionedWidget(widget: <opaque>, state: {self.state.toText()}, rect: {self.rect.toText()})"
  }
}
impl PositionedWidget[Any] {
  public fun toText(self: Self) Text {
    # TODO(JonasWanke): print widget, state if possible
    "PositionedWidget(widget: <opaque>, state: <opaque>, rect: {self.rect.toText()})"
  }
}

public struct Context {
  # TODO(JonasWanke): add more fields
}

# TypedWidget

# TODO(JonasWanke): private
public trait TypedWidget {
  type State
  fun initialState(self: Self) Self.State
  fun layout(self: Self, state: Self.State, constraints: Constraints, context: Context) LaidOutChild[Self.State]
  fun paint(self: Self, state: Self.State, size: Size) List[DrawCommand]
  fun handle(self: Self, state: Self.State, path: List[Int], message: Any) Self.State
}
impl[W: TypedWidget] W: Widget {
  fun initialState(self: Self) Any {
    self.initialState()
  }
  fun layout(self: Self, state: Any, constraints: Constraints, context: Context) LaidOutWidget[Any] {
    let result = self.layout(state.downcast[W.State]().unwrap(), constraints, context)
    LaidOutWidget(self, result.state, result.size)
  }
  fun paint(self: Self, state: Any, size: Size) List[DrawCommand] {
    self.paint(state.downcast[W.State]().unwrap(), size)
  }
  fun handle(self: Self, state: Any, path: List[Int], message: Any) Any {
    self.handle(state.downcast[W.State]().unwrap(), path, message)
  }
}

# LeafWidget

public trait LeafWidget {
  type State
  fun initialState(self: Self) Self.State
  fun layout(self: Self, state: Self.State, constraints: Constraints, context: Context) LaidOutChild[Self.State]
  fun paint(self: Self, state: Self.State, size: Size) List[DrawCommand]
  fun handle(self: Self, state: Self.State, path: List[Int], message: Any) Self.State { state }
}
struct LeafState {}
public struct LaidOutLeafWidget[S] {
  public state: S,
  public size: Size,
}
impl[W: LeafWidget] W: TypedWidget {
  type State = W.State
  fun initialState(self: Self) Self.State {
    self.initialState()
  }
  fun layout(self: Self, state: Self.State, constraints: Constraints, context: Context) LaidOutChild[Self.State] {
    self.layout(state, constraints, context)
  }
  fun paint(self: Self, state: Self.State, size: Size) List[DrawCommand] {
    self.paint(state, size)
  }
  fun handle(self: Self, state: Self.State, path: List[Int], message: Any) Self.State {
    self.handle(state, path, message)
  }
}

# SingleChildWidget

public trait SingleChildWidget {
  type State
  fun initialState(self: Self) Self.State
  fun child(self: Self) Widget
  fun layout(self: Self, state: Self.State, child: Child, constraints: Constraints, context: Context) LaidOutSingleChildWidget[Self.State]
  fun paint(self: Self, state: Self.State, child: PositionedWidget[Any], size: Size) List[DrawCommand] {
    child.paint()
  }
  fun handle(self: Self, state: Self.State, path: List[Int], message: Any) Self.State { state }
}
struct SingleChildState[S] {
  own: S,
  child: PositionedWidget[Any],
}
public struct LaidOutSingleChildWidget[S] {
  public size: Size,
  public state: S,
  public child: PositionedWidget[Any],
}
impl[W: SingleChildWidget] W: TypedWidget {
  type State = SingleChildState[W.State]
  fun initialState(self: Self) Self.State {
    let child = self.child()
    let child = PositionedWidget(child, child.initialState(), Rect.fromOffsetAndSize(Offset(0, 0), Size(0, 0)))
    SingleChildState(self.initialState(), child)
  }
  fun layout(self: Self, state: Self.State, constraints: Constraints, context: Context) LaidOutChild[Self.State] {
    let result = self.layout(state.own, Child(state.child.widget, state.child.state), constraints, context)
    LaidOutChild(SingleChildState(result.state, result.child), result.size)
  }
  fun paint(self: Self, state: Self.State, size: Size) List[DrawCommand] {
    self.paint(state.own, state.child, size)
  }
  fun handle(self: Self, state: Self.State, path: List[Int], message: Any) Self.State {
    # TODO(JonasWanke): handle child messages
    SingleChildState(self.handle(state.own, path, message), state.child)
  }
}

