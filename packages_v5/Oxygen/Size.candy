use Oxygen.EdgeInsets

# TODO(JonasWanke): float
public struct Size {
  public width: Int,
  public height: Int,
}
impl Size {
  public fun coerceAtLeast(self: Self, other: Self) Self {
    Size(
      self.width.coerceAtLeast(other.width),
      self.height.coerceAtLeast(other.height),
    )
  }
  public fun coerceAtMost(self: Self, other: Self) Self {
    Size(
      self.width.coerceAtMost(other.width),
      self.height.coerceAtMost(other.height),
    )
  }
  public fun coerceIn(self: Self, min: Self, max: Self) Self {
    self.coerceAtLeast(min).coerceAtMost(max)
  }
}

impl Size: Add[EdgeInsets] {
  type Result = Size
  fun add(self: Self, other: EdgeInsets) Self.Result {
    Size(
      self.width.add(other.horizontal()),
      self.height.add(other.vertical()),
    )
  }
}
impl Size: Subtract[EdgeInsets] {
  type Result = Size
  fun subtract(self: Self, other: EdgeInsets) Self.Result {
    Size(
      self.width.subtract(other.horizontal()),
      self.height.subtract(other.vertical()),
    )
  }
}

impl Size: ToText {
  fun toText(self: Self) Text {
    "{self.width.toText()}×{self.height.toText()}"
  }
}
