use Core.Maybe
use Oxygen.Constraints
use Oxygen.DrawCommand
use Oxygen.Offset
use Oxygen.Size
use Oxygen.Widget

public struct Center {
  public child: Widget,
}
impl Center: SingleChildWidget {
  type State = Nothing
  fun initialState(self: Self) Self.State {
    Nothing()
  }
  fun child(self: Self) Widget {
    self.child
  }
  fun layout(self: Self, state: Self.State, child: Child, constraints: Constraints, context: Context) LaidOutSingleChildWidget[Self.State] {
    let size = constraints.max
    let child = child.layout(Constraints.loose(size), context)
    let offset = Offset(
      (size.width.subtract(child.size.width)),
      (size.height.subtract(child.size.height)),
    ).divideTruncating(2)
    let child = child.place(offset)
    LaidOutSingleChildWidget(size, state, child)
  }
}
