use Core.Maybe
use Oxygen.Constraints
use Oxygen.DrawCommand
use Oxygen.EdgeInsets
use Oxygen.Offset
use Oxygen.Size
use Oxygen.Widget

public struct Padding {
  public padding: EdgeInsets,
  public child: Widget,
}
impl Padding: SingleChildWidget {
  type State = Nothing
  fun initialState(self: Self) Self.State {
    Nothing()
  }
  fun child(self: Self) Widget {
    self.child
  }
  fun layout(self: Self, state: Self.State, child: Child, constraints: Constraints, context: Context) LaidOutSingleChildWidget[Self.State] {
    let innerConstraints = constraints.subtract(self.padding)
    let child = child.layout(innerConstraints, context).place(self.padding.topLeft())
    LaidOutSingleChildWidget(child.rect.size().add(self.padding), state, child)
  }
}
