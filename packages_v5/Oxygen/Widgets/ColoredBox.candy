use Oxygen.Color
use Oxygen.Constraints
use Oxygen.DrawCommand
use Oxygen.Offset
use Oxygen.Rect
use Oxygen.Size
use Oxygen.Widget

public struct ColoredBox {
  public color: Color,
  public child: Widget,
}
impl ColoredBox: SingleChildWidget {
  type State = Nothing
  fun initialState(self: Self) Self.State {
    Nothing()
  }
  fun child(self: Self) Widget {
    self.child
  }
  fun layout(self: Self, state: Self.State, child: Child, constraints: Constraints, context: Context) LaidOutSingleChildWidget[Self.State] {
    let child = child.layout(constraints, context).place(Offset(0, 0))
    LaidOutSingleChildWidget(child.rect.size(), state, child)
  }
  fun paint(self: Self, state: Self.State, child: PositionedWidget[Any], size: Size) List[DrawCommand] {
    List.of(DrawCommand.drawRect(DrawRect(Rect.fromOffsetAndSize(Offset(0, 0), size), Paint(self.color))))
      .concat(child.paint())
  }
}
