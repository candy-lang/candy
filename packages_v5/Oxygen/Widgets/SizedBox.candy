use Core.Maybe
use Oxygen.Constraints
use Oxygen.DrawCommand
use Oxygen.Offset
use Oxygen.Size
use Oxygen.Widget

public struct SizedBox {
  public size: Size,
  public child: Widget,
}
impl SizedBox: SingleChildWidget {
  type State = Nothing
  fun initialState(self: Self) Self.State {
    Nothing()
  }
  fun child(self: Self) Widget {
    self.child
  }
  fun layout(self: Self, state: Self.State, child: Child, constraints: Constraints, context: Context) LaidOutSingleChildWidget[Self.State] {
    let size = constraints.constrain(self.size)
    let child = child.layout(Constraints.tight(size), context).place(Offset(0, 0))
    LaidOutSingleChildWidget(size, state, child)
  }
}
